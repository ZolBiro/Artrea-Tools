<Window x:Class="ArtreaTools.BarrayWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ArtreaTools"
             mc:Ignorable="d" Height="280" Width="400" ResizeMode="CanMinimize" Title="Barray" WindowState="Normal"
             WindowStartupLocation="CenterScreen" Loaded="WindowLoaded" WindowStyle="SingleBorderWindow" >

    <Grid Background="#eaf0fa">
        <Label Content="Choose a lamp family:" HorizontalAlignment="Left" Margin="30,10,0,0" VerticalAlignment="Top" FontFamily="Arial" FontSize="16"/>
        <ComboBox x:Name="LightingFixtures" HorizontalAlignment="Left" Margin="30,55,0,0" VerticalAlignment="Top" Width="300" Height="25" Background="White" BorderBrush="#adc2eb">
        </ComboBox>
        <Label Content="Column number:" HorizontalAlignment="Left" Margin="28,105,0,0" VerticalAlignment="Top" FontFamily="Arial" FontSize="12"/>
        <TextBox x:Name="column_number" HorizontalAlignment="Left" Margin="130,105,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="30" Height="20" Background="White" BorderBrush="#adc2eb"/>
        <Label Content="Row number:" HorizontalAlignment="Left" Margin="200,105,0,0" VerticalAlignment="Top" FontFamily="Arial" FontSize="12"/>
        <TextBox x:Name="row_number" HorizontalAlignment="Left" Margin="288,105,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="30" Height="20" Background="White" BorderBrush="#adc2eb"/>
        <Label Content="Lamp mounting height:" HorizontalAlignment="Left" Margin="30,140,0,0" VerticalAlignment="Top" FontFamily="Arial" FontSize="12"/>
        <TextBox x:Name="lamp_height" HorizontalAlignment="Left" Margin="170
                 ,142,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="50" Height="20" Background="White" BorderBrush="#adc2eb"/>
        <Button Content="Axis selection" HorizontalAlignment="Left" Margin="30,180,0,20" VerticalAlignment="Top" Height="30" Width="170" Click="LineSelect" FontFamily="Arial" FontSize="16" Background="White" BorderBrush="#adc2eb"/>
    </Grid>
</Window>
